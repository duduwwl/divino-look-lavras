# Banco PostgreSQL (Neon via Vercel Marketplace). Nunca exponha como NEXT_PUBLIC_*.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Segredo longo e aleatório para anonimizar IPs usados no antispam.
DATA_HASH_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Chave base64url de 32 bytes para criptografar dados pessoais no banco.
DATA_ENCRYPTION_KEY=gere-com-criptografia-segura-e-guarde-apenas-na-vercel

# Endereço público após publicar na Vercel.
NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=5535988281548
